generator client {
  provider = "prisma-client-js"
}

// SQLite for local dev. For production switch provider to "postgresql" and DATABASE_URL.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// School.status: PENDING | APPROVED | REJECTED | SUSPENDED
model School {
  id              String    @id @default(cuid())
  name            String
  address         String
  city            String
  phone           String
  email           String    @unique
  registrationNo  String?
  principalName   String
  status          String    @default("PENDING")
  rejectReason    String?
  feeReminderDays Int       @default(3) // days before due date to start reminding
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?

  users         User[]
  classes       SchoolClass[]
  batches       Batch[]
  students      Student[]
  events        Event[]
  feeStructures FeeStructure[]
  scheduled     ScheduledNotification[]
  pickups       PickupRequest[]
  media         Media[]
}

// User.role: SUPER_ADMIN | PRINCIPAL | TEACHER | HELPER | STAFF | PARENT
model User {
  id                 String   @id @default(cuid())
  schoolId           String?
  role               String
  name               String
  email              String?  @unique
  phone              String?  @unique
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  designation        String?
  salary             Int?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  school        School?  @relation(fields: [schoolId], references: [id])
  batchesTaught Batch[]
  children      Student[]
  notifications Notification[]
  deviceTokens  DeviceToken[]
}

// A grade level such as "Jr KG" or "Sr KG". Fees are defined per class.
model SchoolClass {
  id       String @id @default(cuid())
  schoolId String
  name     String

  school        School         @relation(fields: [schoolId], references: [id])
  batches       Batch[]
  feeStructures FeeStructure[]
  scheduled     ScheduledNotification[]

  @@unique([schoolId, name])
}

// A shift of a class, e.g. Jr KG - Morning (9:00-12:00) with one class teacher.
model Batch {
  id           String  @id @default(cuid())
  schoolId     String
  classId      String
  name         String // Morning | Noon
  startTime    String? // "09:00"
  endTime      String?
  academicYear String
  capacity     Int     @default(25)
  teacherId    String?

  school    School      @relation(fields: [schoolId], references: [id])
  class     SchoolClass @relation(fields: [classId], references: [id])
  teacher   User?       @relation(fields: [teacherId], references: [id])
  students  Student[]
  homework  Homework[]
  events    Event[]
  media     Media[]
  scheduled ScheduledNotification[]

  @@unique([schoolId, classId, name, academicYear])
}

model Student {
  id            String   @id @default(cuid())
  schoolId      String
  batchId       String
  parentId      String
  name          String
  dob           DateTime
  gender        String?
  admissionNo   String
  admissionDate DateTime @default(now())
  status        String   @default("ACTIVE") // ACTIVE | LEFT
  bloodGroup    String?
  allergies     String?

  school     School  @relation(fields: [schoolId], references: [id])
  batch      Batch   @relation(fields: [batchId], references: [id])
  parent     User    @relation(fields: [parentId], references: [id])
  medical    MedicalRecord[]
  reports    ProgressReport[]
  invoices   FeeInvoice[]
  attendance Attendance[]
  pickups    PickupRequest[]
  mediaTags  MediaTag[]

  @@unique([schoolId, admissionNo])
}

model MedicalRecord {
  id        String   @id @default(cuid())
  studentId String
  authorId  String?
  type      String // CHECKUP | VACCINATION | ILLNESS | ALLERGY | OTHER
  title     String
  notes     String?
  date      DateTime
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
}

model ProgressReport {
  id         String   @id @default(cuid())
  studentId  String
  authorId   String
  term       String
  language   Int? // 1-5 rating
  numeracy   Int?
  social     Int?
  motor      Int?
  creativity Int?
  remarks    String?
  createdAt  DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id])
}

// status: PRESENT | ABSENT | LATE (lateMinutes set for LATE)
model Attendance {
  id          String   @id @default(cuid())
  studentId   String
  date        DateTime
  status      String
  lateMinutes Int?
  student     Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
}

// kind: CLASSWORK | HOMEWORK
model Homework {
  id          String    @id @default(cuid())
  batchId     String
  authorId    String
  kind        String    @default("HOMEWORK")
  title       String
  description String
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  batch       Batch     @relation(fields: [batchId], references: [id])
}

// type: IMAGE | VIDEO. With tags => about specific children; without => shared with whole batch.
model Media {
  id         String   @id @default(cuid())
  schoolId   String
  batchId    String
  uploaderId String
  type       String
  mime       String
  fileName   String   @unique
  caption    String?
  activity   String?
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id])
  batch      Batch    @relation(fields: [batchId], references: [id])
  tags       MediaTag[]
}

model MediaTag {
  mediaId   String
  studentId String
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id])

  @@id([mediaId, studentId])
}

model Event {
  id           String   @id @default(cuid())
  schoolId     String
  batchId      String? // null = whole school
  title        String
  description  String?
  date         DateTime
  reminderSent Boolean  @default(false)
  school       School   @relation(fields: [schoolId], references: [id])
  batch        Batch?   @relation(fields: [batchId], references: [id])
}

// frequency: MONTHLY | QUARTERLY | YEARLY | ONE_TIME. amount in paise.
model FeeStructure {
  id        String @id @default(cuid())
  schoolId  String
  classId   String
  name      String // Tuition, Transport, Admission...
  amount    Int
  frequency String
  dueDay    Int    @default(10)
  school    School      @relation(fields: [schoolId], references: [id])
  class     SchoolClass @relation(fields: [classId], references: [id])
  invoices  FeeInvoice[]
}

// status: PENDING | PARTIAL | PAID
model FeeInvoice {
  id             String    @id @default(cuid())
  studentId      String
  feeStructureId String
  period         String // 2026-10
  amount         Int
  paidAmount     Int       @default(0)
  dueDate        DateTime
  status         String    @default("PENDING")
  lastReminderAt DateTime?
  student        Student      @relation(fields: [studentId], references: [id])
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments       Payment[]

  @@unique([studentId, feeStructureId, period])
}

model Payment {
  id        String     @id @default(cuid())
  invoiceId String
  amount    Int
  method    String // CASH | UPI | CARD | BANK
  reference String?
  paidAt    DateTime   @default(now())
  invoice   FeeInvoice @relation(fields: [invoiceId], references: [id])
}

// Principal-defined announcements. kind ONCE fires on `date`; MONTHLY fires on `dayOfMonth` every month
// (clamped to month length) at `sendHour` server time. audience: SCHOOL | CLASS | BATCH
model ScheduledNotification {
  id         String    @id @default(cuid())
  schoolId   String
  title      String
  body       String
  audience   String    @default("SCHOOL")
  classId    String?
  batchId    String?
  kind       String
  date       DateTime?
  dayOfMonth Int?
  sendHour   Int       @default(9)
  active     Boolean   @default(true)
  lastSentOn String? // YYYY-MM-DD, prevents double sends
  createdAt  DateTime  @default(now())
  school     School       @relation(fields: [schoolId], references: [id])
  class      SchoolClass? @relation(fields: [classId], references: [id])
  batch      Batch?       @relation(fields: [batchId], references: [id])
}

// A parent asks for someone else to pick up / drop the child. Teacher verifies `code` at handover.
// type: PICKUP | DROP | BOTH. status: PENDING | APPROVED | REJECTED | CANCELLED | COMPLETED
model PickupRequest {
  id            String    @id @default(cuid())
  schoolId      String
  studentId     String
  parentId      String
  personName    String
  personPhone   String
  relation      String
  type          String
  date          DateTime
  reason        String?
  status        String    @default("PENDING")
  code          String?
  decisionNote  String?
  decidedAt     DateTime?
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime  @default(now())
  school        School    @relation(fields: [schoolId], references: [id])
  student       Student   @relation(fields: [studentId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // HOMEWORK | EVENT | FEE | PICKUP | ATTENDANCE | MEDIA | GENERAL
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model DeviceToken {
  id     String @id @default(cuid())
  userId String
  token  String @unique
  user   User   @relation(fields: [userId], references: [id])
}
