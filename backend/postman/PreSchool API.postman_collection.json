              "mode": "raw",
              "raw": "{\n  \"title\": \"Annual Day\",\n  \"description\": \"School celebration\",\n  \"date\": \"2026-12-15T09:00:00.000Z\",\n  \"batchId\": \"{{batchId}}\"\n}",
