{
  "info": {
    "_postman_id": "6d7c4b82-0e5f-4dbd-84d3-7a90c8cae652",
    "name": "PreSchool Backend API",
    "description": "Postman collection for the Express backend. Set baseUrl to the backend origin (for example http://localhost:4000) and sign in with each role to populate the token collection variable. Protected requests use the current bearer token. Replace the ID variables with values returned by your API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "schoolId", "value": "replace-with-school-id", "type": "string" },
    { "key": "classId", "value": "replace-with-class-id", "type": "string" },
    { "key": "batchId", "value": "replace-with-batch-id", "type": "string" },
    { "key": "studentId", "value": "replace-with-student-id", "type": "string" },
    { "key": "staffId", "value": "replace-with-staff-id", "type": "string" },
    { "key": "parentId", "value": "replace-with-parent-user-id", "type": "string" },
    { "key": "feeStructureId", "value": "replace-with-fee-structure-id", "type": "string" },
    { "key": "invoiceId", "value": "replace-with-invoice-id", "type": "string" },
    { "key": "eventId", "value": "replace-with-event-id", "type": "string" },
    { "key": "notificationId", "value": "replace-with-scheduled-notification-id", "type": "string" },
    { "key": "pickupRequestId", "value": "replace-with-pickup-request-id", "type": "string" },
    { "key": "mediaId", "value": "replace-with-media-id", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Authentication and public",
      "item": [
        {
          "name": "Log in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin@preschool.app\",\n  \"password\": \"Admin@12345\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "On success, automatically stores the returned JWT in the collection variable token."
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"NewPassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/change-password"
          }
        },
        {
          "name": "Register device token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"replace-with-device-push-token\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/device-token"
          }
        },
        {
          "name": "Register school",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Little Steps Preschool\",\n  \"address\": \"12 Example Road\",\n  \"city\": \"Bengaluru\",\n  \"phone\": \"9876543210\",\n  \"email\": \"principal@example.com\",\n  \"registrationNo\": \"REG-001\",\n  \"principalName\": \"Asha Rao\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/schools/register"
          }
        },
        {
          "name": "Get my notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/me/notifications"
          }
        },
        {
          "name": "Mark all notifications read",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/me/notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "Super admin",
      "item": [
        {
          "name": "List schools",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/schools?status=PENDING",
            "description": "Optional query: status (for example PENDING, APPROVED, REJECTED, SUSPENDED)."
          }
        },
        {
          "name": "Approve school",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/schools/{{schoolId}}/approve"
          }
        },
        {
          "name": "Reject school",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Please provide the missing registration document.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/schools/{{schoolId}}/reject"
          }
        },
        {
          "name": "Suspend school",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/schools/{{schoolId}}/suspend"
          }
        }
      ]
    },
