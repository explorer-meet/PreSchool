            },
            "url": "{{baseUrl}}/api/principal/events"
          }
        },
        {
          "name": "List scheduled notifications",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/principal/notifications" }
        },
        {
          "name": "Create scheduled notification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audience\": \"SCHOOL\",\n  \"title\": \"Term begins soon\",\n  \"body\": \"Please check the school calendar.\",\n  \"kind\": \"ONCE\",\n  \"date\": \"2026-11-01T09:00:00.000Z\",\n  \"sendHour\": 9\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/principal/notifications",
            "description": "Use kind ONCE with date or MONTHLY with dayOfMonth. CLASS audience requires classId; BATCH audience requires batchId."
          }
        },
        {
          "name": "Activate or deactivate scheduled notification",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/principal/notifications/{{notificationId}}"
          }
        },
        {
          "name": "Delete scheduled notification",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/principal/notifications/{{notificationId}}" }
        },
        {
          "name": "Broadcast to parents",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audience\": \"SCHOOL\",\n  \"title\": \"Reminder\",\n  \"body\": \"School will be closed on Friday.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/principal/broadcast",
            "description": "Use audience SCHOOL, CLASS (with classId), or BATCH (with batchId)."
          }
        },
        {
          "name": "List pickup requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/principal/pickup-requests?status=PENDING"
          }
        },
        {
          "name": "Approve or reject pickup request",
