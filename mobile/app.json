{
  "expo": {
    "name": "TinySteps",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tinysteps.preschool",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow TinySteps to take photos and videos of children for their parents.",
          "photosPermission": "Allow TinySteps to choose photos and videos to share with parents.",
          "microphonePermission": "Allow TinySteps to record audio with videos."
        }
      ],
      "expo-notifications",
      "expo-status-bar"
    ]
  }
}
